{
  "name": "PostgREST",
  "description": "PostgreSQL REST API server - automatically creates a RESTful API from a PostgreSQL database",
  "extends": "docker-compose",
  "icon": "icon.svg",
  "tags": [
    "api",
    "database"
  ],
  "parameters": [
    "http_port",
    "local_https_port",
    "db_schemas",
    "db_anon_role",
    "pgrst_jwt_secret",
    "pgrst_pre_request",
    "pgrst_jwks_url"
  ],
  "supported_addons": [
    "addon-mtls"
  ],
  "properties": [
    {
      "id": "hostname",
      "default": "postgrest"
    },
    {
      "id": "compose_project",
      "value": "postgrest"
    },
    {
      "id": "volumes",
      "default": "certs=certs,0755,0:0\njwks=/etc/postgrest/jwks,0755,0:0"
    },
    {
      "id": "compose_file",
      "value": ""
    },
    {
      "id": "ssl_mode",
      "value": "proxy"
    },
    {
      "id": "ssl.needs_server_cert",
      "value": "true"
    },
    {
      "id": "ssl.needs_ca_cert",
      "value": "true"
    }
  ],
  "dependencies": [
    {
      "application": "postgres"
    }
  ],
  "installation": {
    "pre_start": [
      "conf-rebuild-schemas.json",
      "conf-fetch-jwks.json"
    ]
  },
  "reconfigure": {
    "pre_start": [
      "conf-rebuild-schemas.json",
      "conf-fetch-jwks.json"
    ]
  },
  "stacktype": [
    "postgres",
    "postgrest"
  ],
  "stack_usage": [
    {
      "stacktype": "postgres",
      "vars": [
        {
          "name": "POSTGRES_PASSWORD",
          "replacement": "manual"
        }
      ]
    }
  ]
}
